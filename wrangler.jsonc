{
  "name": "proprium-host",
  "workers_dev": false,
  "compatibility_date": "2026-10-25",
  "env": {
    "production": {
      "name": "proprium-host-production",
      "workers_dev": false,
      "routes": [{ "pattern": "proprium.yohn.jp", "custom_domain": true }]
    }
  },
  "assets": {
    "directory": "./dist/proprium",
    "not_found_handling": "single-page-application"
  }
}
