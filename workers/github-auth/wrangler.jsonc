{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proprium-github-auth-relay",
  "main": "./github-auth-worker.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "env": {
    "preview": {
      "name": "proprium-github-auth-relay-preview",
      "routes": [{ "pattern": "proprium-auth-preview.yohn.jp", "custom_domain": true }]
    },
    "production": {
      "name": "proprium-github-auth-relay-production",
      "routes": [{ "pattern": "proprium-auth.yohn.jp", "custom_domain": true }]
    }
  }
}
