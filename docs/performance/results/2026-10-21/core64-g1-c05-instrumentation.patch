+type Core64RenderMeasurementProbe = {
+  measure(name: string, durationMs: number, itemCount: number): void;
+};
+
+/** The disposable Core 64 harness injects this probe; normal editor behavior is unchanged. */
+function measureEditorDocumentString(doc: EditorState["doc"], reason: string): string {
+  const probe = typeof window === "undefined"
+    ? undefined
+    : (window as Window & { __scriptoriumCore64RenderProbe?: Core64RenderMeasurementProbe }).__scriptoriumCore64RenderProbe;
+  if (!probe) return doc.toString();
+  const start = performance.now();
+  const text = doc.toString();
+  probe.measure(`editor.docToString.${reason}`, performance.now() - start, doc.length);
+  return text;
+}
+
+function measureEditorFullRangeDispatch(text: string): void {
+  const probe = typeof window === "undefined"
+    ? undefined
+    : (window as Window & { __scriptoriumCore64RenderProbe?: Core64RenderMeasurementProbe }).__scriptoriumCore64RenderProbe;
+  if (!probe) return;
+  probe.measure("editor.fullRangeDispatch.utf8Bytes", 0, new TextEncoder().encode(text).byteLength);
+  probe.measure("editor.fullRangeDispatch.utf16CodeUnits", 0, text.length);
+}
+
