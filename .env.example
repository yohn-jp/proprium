# Generate a unique secret with: openssl rand -hex 32
SCRIPTORIUM_AUTH_TOKEN=
# Server-side token with access only to the intended work repositories.
SCRIPTORIUM_GITHUB_TOKEN=
SCRIPTORIUM_DATA_DIR=./data
# Select the same profile when building and starting: core or full.
SCRIPTORIUM_PROFILE=core
# Private usage/job history; keep it persistent independently of Core clone recovery.
SCRIPTORIUM_USAGE_DIR=./host-history
HOST=127.0.0.1
PORT=3000
