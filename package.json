{
  "name": "proprium",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:browser": "pnpm --dir app exec vite --config vite.proprium.config.ts",
    "build:browser": "pnpm --dir app exec vite build --config vite.proprium.config.ts && node scripts/verify-proprium-static.mjs",
    "typecheck:browser": "pnpm --filter @scriptorium/app typecheck:proprium",
    "test:browser:unit": "pnpm --filter @scriptorium/app test:proprium",
    "test:browser:e2e": "node scripts/run-proprium-e2e.mjs",
    "verify:browser": "pnpm typecheck:browser && pnpm test:browser:unit && pnpm build:browser && pnpm exec wrangler deploy --dry-run --config wrangler.jsonc",
    "build": "pnpm build:browser",
    "typecheck": "pnpm typecheck:browser",
    "test": "pnpm test:browser:unit && pnpm test:browser:e2e",
    "test:e2e": "pnpm test:browser:e2e",
    "verify": "pnpm verify:browser"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "wrangler": "4.152.0"
  }
}
