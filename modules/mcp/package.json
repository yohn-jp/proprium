{
  "name": "@scriptorium/module-mcp",
  "private": true,
  "version": "0.1.0",
  "scriptoriumDisplay": {
    "name": "MCP connections",
    "description": "Connect an authorized MCP client to Scriptorium tools through Praetorium OAuth; proposed changes still require author approval."
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@scriptorium/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "scriptoriumModule": {
    "id": "mcp",
    "version": "0.1.0",
    "contractVersion": 1,
    "dependencies": [],
    "provides": [],
    "requires": [],
    "serverEntry": "./dist/index.js",
    "statePaths": [],
    "locality": "local"
  },
  "bin": {
    "scriptorium-mcp": "./dist/stdio.js"
  }
}
