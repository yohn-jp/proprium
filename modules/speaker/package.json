{
  "name": "@scriptorium/module-speaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./worker": "./dist/worker.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@scriptorium/contracts": "workspace:*",
    "@scriptorium/migration": "workspace:*",
    "@scriptorium/module-runtime": "workspace:*",
    "@scriptorium/module-story": "workspace:*",
    "@scriptorium/module-nlp": "workspace:*",
    "yaml": "^2.8.1",
    "@scriptorium/module-diagnostics": "workspace:*",
    "zod": "3.25.76"
  },
  "scriptoriumModule": {
    "id": "speaker",
    "version": "0.1.0",
    "contractVersion": 1,
    "dependencies": [
      "story",
      "nlp",
      "diagnostics"
    ],
    "provides": [],
    "requires": [
      "nlp.tokenizer"
    ],
    "serverEntry": "./dist/index.js",
    "browserEntry": "./dist/browser.js",
    "workerEntry": "./dist/worker.js",
    "statePaths": [
      "meta/scriptorium/modules/speaker",
      "plot/volumes"
    ],
    "locality": "local"
  }
}
